{
  "name": "lume-engine",
  "version": "1.2.0",
  "private": true,
  "description": "Lume engine for the CIMB Niaga Social Hub: API, workers, connectors and compliance gate",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js all",
    "start:api": "node dist/index.js api",
    "start:worker": "node dist/index.js worker",
    "migrate": "node dist/index.js migrate",
    "seed": "node dist/index.js seed",
    "dev": "tsx src/index.ts all",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "bullmq": "^5.81.5",
    "fastify": "^5.12.8",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
