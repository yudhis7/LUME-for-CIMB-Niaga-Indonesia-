# Lume engine settings. Copy to .env (docker compose) or set as environment variables / secrets.
# Anything marked SECRET belongs in the secrets manager (AWS Secrets Manager / Vault), not in a file.

NODE_ENV=production
TZ=Asia/Jakarta
PUBLIC_URL=https://social-hub.example.co.id
WORKSPACE_ID=cimb-niaga
PORT=8080

# Databases (docker compose sets these for you)
# DATABASE_URL=postgres://lume:SECRET@db-host:5432/lume
# DATABASE_SSL=true
# REDIS_URL=rediss://cache-host:6379

# Security
DATA_KEY=                      # SECRET: 32 random bytes, base64 (openssl rand -base64 32). Encrypts platform tokens.
COOKIE_SECURE=true             # true behind HTTPS
SESSION_HOURS=12
SESSION_REMEMBER_DAYS=7
LOGIN_MAX_FAILS=5
LOGIN_LOCK_SECONDS=900         # pilot UI used 30 s; 15 min is a sensible bank setting
PILOT_PASSWORD=                # SECRET: password for the pilot accounts (replaced by SSO in production)

# Pilot / UAT: sample data, reset button, simulated incoming messages
DEMO_MODE=true

# Platforms: sandbox simulates every call; live calls the real APIs
CONNECTOR_MODE=sandbox
META_APP_ID=
META_APP_SECRET=               # SECRET: verifies Meta webhooks
META_VERIFY_TOKEN=             # SECRET: any random string, also entered in the Meta app's webhook settings
META_GRAPH_VERSION=v26.0
X_CONSUMER_SECRET=             # SECRET: only for the X Account Activity webhook; mentions are polled otherwise
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=          # SECRET
WHATSAPP_PHONE_NUMBER_ID=      # WhatsApp Business number used to notify advocates
WHATSAPP_TOKEN=                # SECRET
WHATSAPP_TASK_TEMPLATE=lume_task_new

# CIMB Niaga complaint management system
CMS_MODE=sandbox               # http = call CMS_URL/complaints
CMS_URL=
CMS_TOKEN=                     # SECRET

# Internal alerts
SMTP_URL=                      # e.g. smtp://relay.internal:25 (bank mail relay)
MAIL_FROM=Lume <no-reply@social-hub.example.co.id>
ALERT_WEBHOOK_URL=             # Microsoft Teams / Slack / Google Chat incoming webhook
ALERT_EMAILS_FRAUD=
ALERT_EMAILS_COMMS=
ALERT_EMAILS_COMPLIANCE=
ALERT_EMAILS_CARE=

# Claude (captions, reply drafts, briefs). Empty = approved templates only.
ANTHROPIC_API_KEY=             # SECRET
AI_MODEL=claude-sonnet-5-5
AI_MAX_TOKENS=600

# Data retention and detection
RAW_EVENT_RETENTION_DAYS=30
SCAM_WAVE_THRESHOLD=3
SCAM_WAVE_WINDOW_MIN=60
LOG_LEVEL=info
